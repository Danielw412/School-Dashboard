CANVAS_API_TOKEN=replace-with-your-token
CANVAS_BASE_URL=https://school.instructure.com
TASK_SYNC_API_BASE=http://127.0.0.1:8890/api/v1
# When Canvas Task Sync runs on a server, set its SSH target (for example daniel@100.87.157.44).
# The dashboard then keeps its own tunnel to the backend and ignores TASK_SYNC_API_BASE.
TASK_SYNC_SSH_TARGET=
TASK_SYNC_REMOTE_PORT=8790
SCHOOL_DASHBOARD_PORT=8892
SCHOOL_DASHBOARD_CACHE_TTL_MINUTES=30
SCHOOL_DASHBOARD_CACHE_MAX_MB=512
TEST_QUESTION_PREDICTOR_COMMAND=

# --- Server / laptop split ------------------------------------------------------------------
# Dashboard server: listen on the tailnet (requests are limited to loopback and Tailscale peers)
# and send every Codex run to the laptop agent worker.
#   SCHOOL_DASHBOARD_HOST=0.0.0.0
#   SCHOOL_DASHBOARD_AGENT_EXECUTION=worker
# Leave both unset to keep the original single-machine setup (loopback only, Codex in-process).
SCHOOL_DASHBOARD_HOST=
SCHOOL_DASHBOARD_AGENT_EXECUTION=
# Shared secret between the dashboard server and the laptop worker (same value on both).
SCHOOL_DASHBOARD_WORKER_TOKEN=
# Laptop agent worker only: the dashboard server it dials out to over Tailscale.
SCHOOL_DASHBOARD_SERVER_URL=
SCHOOL_DASHBOARD_WORKER_CONCURRENCY=3
# Optional: extra Host names (comma-separated) and allowed networks
# (loopback, tailscale, or CIDRs; default loopback,tailscale).
SCHOOL_DASHBOARD_ALLOWED_HOSTS=
SCHOOL_DASHBOARD_ALLOWED_NETWORKS=
